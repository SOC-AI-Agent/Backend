# soc-backend — only the settings this service reads.
#
# Split out of the SOC-AI monorepo, where one .env was shared by every
# container. Sharing it meant the Splunk connector's environment also held
# the database password and the ThreatQ credentials, so a compromise of any
# one service read the secrets of all of them.

# ========== DATABASE ==========
POSTGRES_DB=socai
POSTGRES_USER=socai
POSTGRES_PASSWORD=change_me_please

# Prisma (NestJS core backend) — plain postgresql:// scheme
CORE_DATABASE_URL=postgresql://socai:change_me_please@soc-db:5432/socai

# SQLAlchemy (Python AI service) — asyncpg scheme
DATABASE_URL=postgresql+asyncpg://socai:change_me_please@soc-db:5432/socai

# ========== REDIS ==========
REDIS_URL=redis://soc-redis:6379/0
REDIS_HOST=soc-redis
REDIS_PORT=6379
REDIS_DB=0

# ========== QUEUE / WORKER ==========
# APP_ROLE is set per container in docker-compose.yml (api | worker)
WORKER_CONCURRENCY=1

# ========== AI SERVICE (FastAPI) ==========
AI_SERVICE_URL=http://soc-ai:8100
# Seconds the backend waits on soc-ai for ONE agent call (soc-ai -> LLM server ->
# agent). Stage 1 makes two such calls and the analysis after the searches makes a
# third, each with its own wait. Keep it above LLM_TIMEOUT below. CPU-only
# inference needs minutes per call.
AI_SERVICE_TIMEOUT=1920

# ========== SPLUNK ==========
# Splunk is outside this Docker network. The backend writes every search itself
# (src/modules/enrichment/spl.ts) and sends the SPL to soc-mcp-splunk's /query route,
# which checks it again — read-only, allowed indexes — and runs it. So the two need
# the same settings: this list, and MCP-Server/.env's, must match.
# Bearer token the connector requires. Generate: openssl rand -hex 32
# Must match MCP_AUTH_TOKEN in MCP-Server/.env byte for byte.
MCP_AUTH_TOKEN=
# Comma-separated index allowlist. Built into every search here and checked again by the
# connector. "*" disables the restriction and has to be typed out on purpose. EMPTY
# REFUSES EVERY SEARCH — an empty list must never fall through to "everything".
SPLUNK_ALLOWED_INDEXES=
# Hard ceiling on rows, whatever a plan asks for.
SPLUNK_MAX_COUNT=200
# Where correlation-search alerts land, and the field holding their name. Splunk ES
# defaults; a plain Splunk install differs. The index must be in the allowlist above.
SPLUNK_ALERT_INDEX=notable
SPLUNK_ALERT_NAME_FIELD=search_name
# The data catalogue: what each index and sourcetype holds and which field carries
# which meaning. Written by a person from GET /catalog. The backend plans from it.
SPLUNK_CATALOG_FILE=/catalog/splunk-catalog.json

# ---------- soc-mcp-threatq ----------
# Indicator reputation from the real ThreatQ. See MCP-Server/Threatq/README.md.
# Bearer token the connector requires. Its own, not the Splunk connector's.
# Generate: openssl rand -hex 32. Must match THREATQ_MCP_AUTH_TOKEN in MCP-Server/.env.
THREATQ_MCP_AUTH_TOKEN=
# Looking an indicator up by value is a search: GET /api/indicators has no
# value filter (REST API Reference v5.12).
# Score, sources and adversaries are related objects and are ABSENT unless named
# here. Without this every indicator comes back looking unscored.
# oauth = password grant at THREATQ_TOKEN_PATH; bearer = static THREATQ_TOKEN.

# ========== OLLAMA ==========
# Reported by /health and /admin/stats. No default in code.
OLLAMA_MODEL=qwen2.5:7b

# ========== LLM SERVER (agent platform) ==========
# soc-ai does not talk to Ollama; it asks the LLM server to run an agent and
# reads the answer off the stream. That server is another team's, so nothing in
# soc-ai assumes its shape — these settings are how it adapts.
# {agent} is substituted. A server that takes the agent in the body instead can
# use a static path here and name the body field in LLM_AGENT_FIELD.
# Body field names — the part that differs most between implementations.
# Extra body fields as JSON, e.g. {"stream": true}
# auto = follow the response content type; always = treat the body as a stream
# whatever it says; never = expect one JSON object.
# If their service wants a bearer token / other headers (JSON).
# An agent run makes several model and tool calls.

# ========== ENRICHMENT (runs in the backend, before the model) ==========
# The worker extracts indicators from the alert and checks them against ThreatQ
# before any agent runs. Both are exact work with one right answer, so they are
# not left for a model to decide whether to bother with.
#
# The ThreatQ gateway's HTTP lookup route. Blank disables enrichment, and the
# summary then says the check did not happen rather than implying it was clean.
THREATQ_LOOKUP_URL=http://soc-mcp-threatq:8300
THREATQ_LOOKUP_TIMEOUT_MS=15000
# One alert can carry dozens of addresses; checking all of them costs the
# platform more than the answer is worth.
THREATQ_MAX_INDICATORS=25
# Which index holds the logs for the device that raised an alert. The SOAR
# already names the device, so the agent's first search is a lookup rather than
# something it has to work out — and a wrong guess there is what makes it report
# "nothing found" for data that is one index away.
#
# Rules are pattern=index[:sourcetype], matched against the alert name and the
# raw log, case-insensitively. First match wins, so put specific rules first.
ALERT_SOURCE_MAP=fortigate=main:fortigate,fgt-=main:fortigate
# Addresses and domains that are ours. An internal value is not worth a lookup,
# and a "no record" reply for one is exactly what gets misread as "clean".
# Comma-separated; a leading dot matches any subdomain.
ENRICHMENT_INTERNAL_VALUES=.corp.local,.internal

# ========== JWT ==========
JWT_SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ========== APP ==========
PORT=8000

# ========== DEFAULT ADMIN (reserved — not read) ==========
# Kept for now, but nothing reads these: the seed creates roles only and no
# code, script or CI job may use them to create or log in a user. The first
# admin is provisioned by hand (docs/setup.md, section 4).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_before_first_seed
DEFAULT_ADMIN_EMAIL=admin@localhost

# ========== RETENTION ==========
RETENTION_DAYS_JOBS=30
RETENTION_DAYS_AUDIT=90
CLEANUP_HOUR=2
CLEANUP_MINUTE=0

# ========== DIAGNOSTICS ==========
# Enables GET /internal/db/schema (admin JWT only). Keep false outside a
# temporary VPN-only inspection.
DB_SCHEMA_DEBUG=false

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:3001,http://soc-frontend:3001

# ── The Splunk stage ────────────────────────────────────────────────────────
# manual = stage 1 stores what it needs and stops; someone presses the button.
# auto   = the lookup is queued as soon as the suggestion is ready.
# Each requirement is a search against Splunk, run straight through the connector.
SPLUNK_LOOKUP_MODE=manual
SPLUNK_LOOKUP_MAX_REQUIREMENTS=5
# After the searches, an agent with no tools reads the results beside the suggestion and
# writes the second reading (cited [splunk N]). false leaves the answers as they are.
SPLUNK_LOOKUP_ANALYSE=true

# The three agents, none with tools — create each from LLM-Server/agents/<name>.json:
#   suggest       reads the alert and its context, writes the suggestion
#   requirements  reads that too, and the suggestion, and writes what to ask Splunk
#   conclude      reads the suggestion and the Splunk results, and writes the analysis
LLM_SUGGEST_AGENT=soc-suggest
LLM_REQUIREMENTS_AGENT=soc-requirements
LLM_CONCLUDE_AGENT=soc-conclude

# The Splunk connector (see SPLUNK above).
SPLUNK_MCP_URL=http://soc-mcp-splunk:8200
SPLUNK_SEARCH_TIMEOUT=120

# ── Confluence playbooks ────────────────────────────────────────────────────
# Which runbook covers an alert. The connector reads a real Confluence space and
# refuses to start without one (MCP-Server/.env); there is no sample fallback.
CONFLUENCE_MCP_URL=http://soc-mcp-confluence:8600
# Must match CONFLUENCE_MCP_AUTH_TOKEN in MCP-Server/.env byte for byte.
# Generate: openssl rand -hex 32
CONFLUENCE_MCP_AUTH_TOKEN=
