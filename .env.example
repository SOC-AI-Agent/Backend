# soc-backend — only the settings this service reads.
#
# Split out of the SOC-AI monorepo, where one .env was shared by every
# container. Sharing it meant the Splunk connector's environment also held
# the database password and the ThreatQ credentials, so a compromise of any
# one service read the secrets of all of them. This one now holds the ThreatQ
# and Confluence credentials itself: the backend calls both directly.

# ========== CERTIFICATES ==========
# Splunk (port 8089), ThreatQ and Confluence are outside this Docker network. If
# their certificates are signed by an internal CA (Splunk's management port is
# self-signed out of the box), Node does not trust them and every call fails with
# "self-signed certificate" / "unable to verify the first certificate". Put the CA
# (PEM; several concatenated if they differ) in certs/ and name it here. ADDED to
# Node's built-in list, not a replacement. There is no switch to turn
# verification off. Never Splunk's own cacert.pem (SplunkCommonCA): its private
# key ships with every Splunk install. See docs/splunk-mcp.md, section 3.2.
#
# The path is where the container sees the file, and that differs:
#   production   /app/certs/company-ca.pem — the copy built into the image, so
#                the file must be committed to certs/. The ./certs mount below
#                is an empty directory there: the deploy's docker runs on the
#                host, where its checkout is not.
#   laptop/lab   /certs/<file>.pem through that mount, no rebuild needed (and a
#                lab CA is not committed)
NODE_EXTRA_CA_CERTS=

# ========== DATABASE ==========
POSTGRES_DB=socai
POSTGRES_USER=socai
POSTGRES_PASSWORD=change_me_please

# Prisma (NestJS core backend) — plain postgresql:// scheme
CORE_DATABASE_URL=postgresql://socai:change_me_please@soc-db:5432/socai

# SQLAlchemy (Python AI service) — asyncpg scheme
DATABASE_URL=postgresql+asyncpg://socai:change_me_please@soc-db:5432/socai

# ========== REDIS ==========
REDIS_URL=redis://soc-redis:6379/0
REDIS_HOST=soc-redis
REDIS_PORT=6379
REDIS_DB=0

# ========== QUEUE / WORKER ==========
# APP_ROLE is set per container in docker-compose.yml (api | worker)
WORKER_CONCURRENCY=1

# ========== AI SERVICE (FastAPI) ==========
AI_SERVICE_URL=http://soc-ai:8100
# Bearer token soc-ai requires on every route but /health — agent runs and the
# playbook index alike. soc-ai refuses to start without one.
# Must match AI_SERVICE_AUTH_TOKEN in AI-Service/.env byte for byte.
# Generate: openssl rand -hex 32
AI_SERVICE_AUTH_TOKEN=
# Seconds the backend waits on soc-ai for ONE agent call (soc-ai -> LLM server ->
# agent). Stage 1 makes two such calls and the analysis after the searches makes a
# third, each with its own wait. Keep it above LLM_TIMEOUT below. CPU-only
# inference needs minutes per call.
AI_SERVICE_TIMEOUT=1920

# ========== SPLUNK ==========
# Stage 2 sends each requirement, as stage 1 stored it, to the Splunk connector
# over MCP (soc-mcp-splunk, MCP-Server/Splunk — tool splunk_lookup). The connector
# builds the prompt, has Text-to-SPL write the search, checks it is read-only, runs
# it and returns the SPL and the rows. No model on this side, and no Splunk
# credentials: which Splunk is behind the connector (mock events, the container in
# MCP-Server/external/splunk, the company's), its token, its index allowlist, the
# row ceiling and Splunk AI Assistant are all set in MCP-Server/.env.
# docs/splunk-mcp.md has the Splunk side.
# The connector's MCP endpoint. A bare base URL gets /services/mcp added.
SPLUNK_MCP_URL=http://soc-mcp-splunk:8200/services/mcp
# Bearer token the connector requires. Generate: openssl rand -hex 32
# Must match MCP_AUTH_TOKEN in MCP-Server/.env byte for byte.
MCP_AUTH_TOKEN=
# Overrides MCP_AUTH_TOKEN for the connector, if the two must differ. Normally blank.
SPLUNK_MCP_TOKEN=
# One MCP tool call, in seconds: Text-to-SPL and the search together. Splunk AI
# Assistant takes tens of seconds; Splunk stops a search at one minute.
SPLUNK_SEARCH_TIMEOUT=120
# The data catalogue: what each index and sourcetype holds and which field carries
# which meaning. Kept in catalog/ in this repo, built into the image at /catalog,
# refreshed from Splunk by the export_catalog CI job (docs/splunk-catalog.md).
# Stage 1 aims each requirement with it; the index and sourcetype ride along to
# Text-to-SPL as hints.
SPLUNK_CATALOG_FILE=/catalog/splunk-catalog.json

# ========== MODEL LABEL ==========
# Reported by /health and /admin/stats. Purely informational: Agent-Server's
# response carries no model name, so this is what shows on the job row and
# /health regardless of which model the agent actually ran on. No default in code.
OLLAMA_MODEL=qwen2.5:7b

# ========== AGENT PLATFORM ==========
# soc-ai does not talk to this directly — it asks soc-ai to run a named agent
# and reads the answer off the stream. The platform soc-ai calls is
# Agent-Server (../Agent-Server), configured entirely in AI-Service/.env
# (LLM_SERVER_URL, LLM_RUN_PATH, ...) — nothing here names it, because this
# repo only ever talks to soc-ai.

# ========== ENRICHMENT (runs in the backend, before the model) ==========
# The worker extracts indicators from the alert and checks them against ThreatQ
# before any agent runs. Both are exact work with one right answer, so they are
# not left for a model to decide whether to bother with.
#
# ThreatQ, called straight from the backend (read-only: a token request and the
# indicator search). Blank THREATQ_BASE_URL disables enrichment, and the summary
# then says the check did not happen rather than implying it was clean.
#   e.g. https://threatq.corp.example
THREATQ_BASE_URL=
# oauth  = password grant at THREATQ_TOKEN_PATH with the three values below,
#          refreshed before it expires
# bearer = a static API token in THREATQ_TOKEN, sent as it is
THREATQ_AUTH_MODE=oauth
THREATQ_TOKEN_PATH=/api/token
THREATQ_CLIENT_ID=
THREATQ_EMAIL=
THREATQ_PASSWORD=
THREATQ_TOKEN=
# Looking an indicator up by value is a search: GET /api/indicators has no
# value filter (REST API Reference v5.12).
THREATQ_SEARCH_PATH=/api/indicators/search
# Score, sources and adversaries are related objects and are ABSENT unless named
# here. Without this every indicator comes back looking unscored.
THREATQ_SEARCH_WITH=score,sources,adversaries,status,type,attributes
# One request to ThreatQ, in milliseconds.
THREATQ_LOOKUP_TIMEOUT_MS=15000
# One alert can carry dozens of addresses; checking all of them costs the
# platform more than the answer is worth.
THREATQ_MAX_INDICATORS=25
# MISP — the open-source threat-intelligence platform, used IN PLACE OF ThreatQ
# when both values are set. MCP-Server/external/misp runs one with the lab's
# IOCs; its setup.py --write-env fills these two. Use a read-only user's key,
# never the admin's.
#   e.g. http://soc-misp:8080 (over soc-network)
MISP_BASE_URL=
MISP_API_KEY=
# false only for a self-signed https instance
MISP_VERIFY_TLS=true
MISP_LOOKUP_TIMEOUT_MS=15000
MISP_MAX_INDICATORS=25
# Which index holds the logs for the device that raised an alert. The SOAR
# already names the device, so the agent's first search is a lookup rather than
# something it has to work out — and a wrong guess there is what makes it report
# "nothing found" for data that is one index away.
#
# Rules are pattern=index[:sourcetype], matched against the alert name and the
# raw log, case-insensitively. First match wins, so put specific rules first.
ALERT_SOURCE_MAP=fortigate=main:fortigate,fgt-=main:fortigate
# Addresses and domains that are ours. An internal value is not worth a lookup,
# and a "no record" reply for one is exactly what gets misread as "clean".
# Comma-separated; a leading dot matches any subdomain.
ENRICHMENT_INTERNAL_VALUES=.corp.local,.internal
# ES notable fields about the search, not the event (its time window, its own
# ids), removed before indicator extraction and before the prompt is built. The
# job row keeps the raw log as sent. Comma-separated; set empty to keep every
# field. Unset uses this same list.
ALERT_DROP_FIELDS=info_min_time,info_max_time,info_search_time,source_event_id,source_guid,orig_time,orig_investigation_type

# ========== JWT ==========
JWT_SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ========== APP ==========
PORT=8000
# The host port soc-core-api is published on (PORT above is the one inside
# the container). 8082, not 8081: on the production host 8081 belongs to the
# FastAPI-era dev stack's soc-backend-dev. Whatever calls the API from outside
# (SOAR, BACKEND_URL) uses this port. Only if it is taken too: a CI variable
# of the same name, with a port the inspect_ports job reports free.
BACKEND_HOST_PORT=8082

# ========== DEFAULT ADMIN (reserved — not read) ==========
# Kept for now, but nothing reads these: the seed creates roles only and no
# code, script or CI job may use them to create or log in a user. The first
# admin is provisioned by hand (docs/setup.md, section 4).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_before_first_seed
DEFAULT_ADMIN_EMAIL=admin@localhost

# ========== RETENTION ==========
RETENTION_DAYS_JOBS=30
RETENTION_DAYS_AUDIT=90
CLEANUP_HOUR=2
CLEANUP_MINUTE=0

# ========== DIAGNOSTICS ==========
# Enables GET /internal/db/schema (admin JWT only). Keep false outside a
# temporary VPN-only inspection.
DB_SCHEMA_DEBUG=false

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:3001,http://soc-frontend:3001

# ── The Splunk stage ────────────────────────────────────────────────────────
# manual = stage 1 stores what it needs and stops; someone presses the button.
# auto   = the lookup is queued as soon as the suggestion is ready.
# off    = stage 1 only: alert + ThreatQ + playbook -> the suggestion agent, and
#          nothing else. No requirements agent, no where-to-search block in the
#          prompt, and the lookup button answers that the stage is off.
# Each requirement goes to Splunk's Text-to-SPL over MCP (see SPLUNK above).
SPLUNK_LOOKUP_MODE=manual
SPLUNK_LOOKUP_MAX_REQUIREMENTS=5
# After the searches, an agent with no tools reads the results beside the suggestion and
# writes the second reading (cited [splunk N]). false leaves the answers as they are.
SPLUNK_LOOKUP_ANALYSE=true
# Add the "how often this alert fired" lookup (needs Splunk ES `notable` or SPLUNK_ALERT_INDEX).
# Set false for plain Splunk installs that have no fired-alert index.
SPLUNK_ALERT_FREQUENCY=true
# When the catalogue has no field for a value, run one small search for it in the
# alert's index/sourcetype and aim at the field it is found in. Cached per sourcetype
# and type; at most SPLUNK_FIELD_PROBE_MAX searches per job.
SPLUNK_FIELD_PROBE=true
SPLUNK_FIELD_PROBE_MAX=3
SPLUNK_FIELD_PROBE_CACHE_HOURS=6

# The three agents, none with tools — each is a slug created in Agent-Server's
# admin UI (http://localhost:7100) or its POST /restful/agents, not a file here:
#   suggest       reads the alert and its context, writes the suggestion
#   requirements  reads that too, and the suggestion, and writes what to ask Splunk
#   conclude      reads the suggestion and the Splunk results, and writes the analysis
LLM_SUGGEST_AGENT=soc-suggest
LLM_REQUIREMENTS_AGENT=soc-requirements
LLM_CONCLUDE_AGENT=soc-conclude
# The fourth agent writes the SPL for each requirement (stage 2) from the connector's
# writer prompt. It is built into Agent-Server (DALL-M), which creates it on its own
# under this fixed slug — nothing to set up. When it fails or its SPL is refused, the
# connector writes the search instead (Text-to-SPL / template).
LLM_SPL_AGENT=soc-spl-writer
# The suggestion and the analysis are checked against the playbook they were shown
# (a verdict must cite [PB:true] or [PB:false], a step or quote must exist in the
# playbook). A reply that fails is sent back to the agent once with what was wrong;
# false keeps it as it came. Either way the check is stored on the job (grounding).
LLM_GROUNDING_RETRY=true

# ── Confluence playbooks ────────────────────────────────────────────────────
# Which runbook covers an alert. The worker reads every current page of the
# playbook space straight from Confluence's REST API (read-only) and sends the
# pages to soc-ai, which extracts, embeds and matches them. Each alert is then
# matched against soc-ai's index. Unset base URL, token or space = nothing is
# synced, and every match says nothing is indexed.
#   Cloud:     https://your-org.atlassian.net/wiki
#   Server/DC: https://confluence.corp.example
# Or an address as the browser shows it — the site and the space key are taken
# from it (the key wins over CONFLUENCE_SPACE_KEY), and it says what is read:
#   .../wiki/spaces/SOC/overview                  the whole space
#   .../wiki/spaces/SOC/pages/123456/Use+Cases    that page and every page under it
#   .../wiki/spaces/SOC/folder/456                every page in that folder
# A page or folder narrows the read on Cloud (API v2) only; Server/DC addresses
# (/display/SOC/...) read the whole space.
CONFLUENCE_BASE_URL=
# Which REST API. auto: v2 for *.atlassian.net (Cloud, where Atlassian is
# retiring v1: /wiki/api/v2/spaces/{id}/pages), v1 for anything else (Server/DC
# has only v1: CONFLUENCE_API_PATH/content). v1 or v2 forces one.
CONFLUENCE_API=auto
# v1 only: appended to the base URL. /rest/api for Server/DC.
CONFLUENCE_API_PATH=/rest/api
# Only when CONFLUENCE_BASE_URL is the bare site: the part after /spaces/ in
# the space's address (or Space settings > Space details > Key).
CONFLUENCE_SPACE_KEY=
# Cloud: the account's email + an API token (basic auth).
# Server/DC: leave the email blank and put a personal access token below (bearer).
# A read-only account that can see only the playbook space.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Pages per request (v2 takes at most 250); the space is paged through to the
# end either way.
CONFLUENCE_PAGE_LIMIT=200
# An HTTP proxy for the Confluence calls alone. Blank: direct (Server/DC inside
# the network). For Cloud (*.atlassian.net) deploy_production fills it with the
# office proxy, BUILD_PROXY — the production host reaches the internet only
# through it — unless a CONFLUENCE_PROXY CI variable says otherwise.
# HTTPS goes through it as a CONNECT tunnel: the proxy sees the host name, not
# the token or the pages. Nothing else the backend calls — soc-ai, Splunk,
# ThreatQ, Redis — goes through it.
CONFLUENCE_PROXY=
# How often the worker re-reads the space. Only fields whose text changed are
# embedded again, so a sync where nothing moved costs one read of the space.
PLAYBOOK_SYNC_MINUTES=60
# Seconds for one sync: reading the space, then indexing it. The first sync on a
# fresh soc-ai volume embeds every page.
PLAYBOOK_SYNC_TIMEOUT=300
# Seconds for one match, asked once per alert before any model runs.
PLAYBOOK_TIMEOUT=15
