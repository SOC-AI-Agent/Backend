meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{core}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{admin_user}}",
    "password": "{{admin_password}}"
  }
}

script:post-response {
  bru.setVar("jwt", res.getBody().access_token);
  if (res.getBody().refresh_token) {
    bru.setVar("refresh_token", res.getBody().refresh_token);
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("returns a token", function() {
    expect(res.getBody().access_token).to.be.a("string");
  });
}

docs {
  Stores access_token as {{jwt}} for everything else.
}
