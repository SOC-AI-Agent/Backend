meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{core}}/health
  body: none
  auth: none
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("reports the AI service", function() {
    expect(res.getBody()).to.have.property("ai_service");
  });
}

docs {
  Reports whether the AI service answers. No auth.
}
