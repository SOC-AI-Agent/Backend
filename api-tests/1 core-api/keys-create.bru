meta {
  name: API keys - create
  type: http
  seq: 6
}

post {
  url: {{core}}/admin/api-keys
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno-test"
  }
}

script:post-response {
  const b = res.getBody();
  bru.setVar("api_key", b.api_key || b.key);
  if (b.id) bru.setVar("api_key_id", b.id);
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("returns the key once", function() {
    const b = res.getBody();
    expect(b.api_key || b.key).to.be.a("string");
  });
}

docs {
  The key is shown once. Stored as {{api_key}} for the SOAR folder.
}
