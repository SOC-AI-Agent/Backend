meta {
  name: Users - update
  type: http
  seq: 10
}

put {
  url: {{core}}/admin/users/{{user_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
  Content-Type: application/json
}

body:json {
  {
    "is_active": true
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
}
