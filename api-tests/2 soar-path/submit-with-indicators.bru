meta {
  name: Submit with playbook indicators
  type: http
  seq: 2
}

post {
  url: {{core}}/v1/analyze
  body: json
  auth: none
}

headers {
  X-API-Key: {{api_key}}
  Content-Type: application/json
}

body:json {
  {
    "alert_id": "BRUNO-002",
    "alert_name": "Malware download blocked",
    "raw_log": "date=2026-09-21 time=07:20:31 devname=\"FGT-01\" srcip=10.1.100.11 dstip=45.83.122.9 dstport=8443 action=\"blocked\" service=\"HTTPS\" dstcountry=\"Russia\" user=\"jdoe\"",
    "indicators": [
      {
        "type": "ip",
        "value": "203.0.113.55",
        "source": "fortisoar"
      }
    ]
  }
}

script:post-response {
  bru.setVar("job_id", res.getBody().job_id);
}

tests {
  test("202 accepted", function() { expect(res.getStatus()).to.equal(202); });
}

docs {
  Indicators the SOAR already parsed win over anything re-derived from the log text: its playbook had the structured record, this side only receives the rendering of it.
}
