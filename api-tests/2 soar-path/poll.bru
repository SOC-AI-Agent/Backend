meta {
  name: Poll for the result
  type: http
  seq: 3
}

get {
  url: {{core}}/v1/results/{{job_id}}
  body: none
  auth: none
}

headers {
  X-API-Key: {{api_key}}
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("status is known", function() {
    expect(["pending","processing","completed","failed"])
      .to.include(res.getBody().status);
  });
}

docs {
  Re-send until status is completed or failed.
}
